# =============================================================================
# docusaurus-reviewops — environment variables reference
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: .env is listed in .gitignore and must NEVER be committed.
#            This file (.env.example) documents which variables exist and why.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM providers — used by `make docs-gen` (scripts/docgen)
# Only the provider you select in .docgen.yml needs to be set.
# -----------------------------------------------------------------------------

# Anthropic Claude (recommended for best documentation quality)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI GPT-4o (alternative provider)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# docgen provider selection (overrides .docgen.yml at runtime)
# Allowed values: ollama | anthropic | openai | claude-code
# Default when unset: read from .docgen.yml (default: ollama)
DOCGEN_PROVIDER=

# Ollama base URL (only needed if Ollama is running on a non-default port/host)
# Default: http://localhost:11434
OLLAMA_BASE_URL=

# -----------------------------------------------------------------------------
# GitHub Actions secrets — set these in GitHub repository settings, not here.
# They are listed here for documentation purposes only.
# Settings > Secrets and variables > Actions > New repository secret
# -----------------------------------------------------------------------------

# GITHUB_TOKEN is automatically injected by GitHub Actions — DO NOT set manually.
# GITHUB_TOKEN=

# PR_NUMBER is injected by pr-approval.yml via github.event.workflow_run — DO NOT set.
# PR_NUMBER=

# ANTHROPIC_API_KEY / OPENAI_API_KEY — also used by docs-gen.yml workflow if set.
# Set as repository secrets, not here.

# -----------------------------------------------------------------------------
# Optional: FastAPI application (used by scripts/export_openapi.py)
# Only needed if you have a FastAPI app and want to generate API reference docs.
# -----------------------------------------------------------------------------

# Python import path to your FastAPI app instance
# Example: myapp.main:app
APP_MODULE=

# Environment your app expects (dev/staging/production)
APP_ENV=development
